# Development settings template. Copy to .env and adjust.
FASTAPI_ENV=development

PROJECT_NAME="GRAMMA"

# Origem do front para CORS e para o link de recuperação de senha.
FRONTEND_HOST=http://localhost:5173
# Outras origens liberadas no CORS (separadas por vírgula), ex.: domínio publicado.
BACKEND_CORS_ORIGINS=

# Validade do token de login em minutos (padrão: 8 dias).
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Limite por IP em login, cadastro e recuperação de senha.
RATE_LIMIT_ENABLED=True
AUTH_RATE_LIMIT=10/minute

# Never commit real secrets. For local dev, values below are fine (dev-only warns).
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (dev: Mailpit at localhost:1025)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Banco de dados: SQLite por padrão (arquivo em backend/gramma.db).
DATABASE_URL=sqlite:///./gramma.db
# Alternativa com PostgreSQL (docker compose up -d db):
# POSTGRES_PASSWORD=changethis
# DATABASE_URL=postgresql://postgres:changethis@localhost:5433/app