# Development settings template. Copy to .env and adjust.
FASTAPI_ENV=development

PROJECT_NAME="GRAMMA"

# Never commit real secrets. For local dev, values below are fine (dev-only warns).
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (dev: Mailpit at localhost:1025)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:changethis@localhost:5433/app